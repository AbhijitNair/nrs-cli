{
  "name": "nrs-cli",
  "version": "2.2.0",
  "description": "NPM Registry Switcher - manage multiple npm registry profiles",
  "type": "module",
  "main": "./src/cli.js",
  "bin": {
    "nrs": "src/cli.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "src/"
  ],
  "keywords": [
    "npm",
    "registry",
    "npmrc",
    "profile",
    "switcher"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "fast-check": "^4.8.0",
    "vitest": "4.1.8"
  }
}
